# 이 파일을 backend/.env 로 복사한 뒤 실제 값으로 채우세요.
# 비밀번호 재설정 메일 발송에 사용되는 SMTP 정보입니다.
# Gmail을 쓸 경우 SMTP_USER는 본인 Gmail 주소, SMTP_PASSWORD는 일반 로그인 비밀번호가 아니라
# 구글 계정 > 보안 > 앱 비밀번호(App Password) 에서 발급받은 16자리 값을 넣어야 합니다.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-digit-app-password
MAIL_FROM=your-email@gmail.com

# 메일 속 재설정 링크가 가리킬 React 앱 주소 (배포하면 실제 도메인으로 변경)
FRONTEND_URL=http://localhost:3000

# 위 SMTP_* 값을 비워두면 실제 메일을 보내지 않고, 대신 서버 콘솔에 재설정 링크를 출력합니다.
# (로컬에서 화면 흐름만 테스트할 때 유용)
