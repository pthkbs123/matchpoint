# 이 파일을 .env로 복사한 뒤 실제 서버 설정으로 채우세요.
# 비밀 키가 포함된 .env는 Git에 커밋하지 않습니다.

# 소셜 로그인
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
KAKAO_REST_API_KEY=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/

# 비밀번호 재설정 메일
# Gmail은 일반 비밀번호가 아니라 Google 계정에서 발급한 앱 비밀번호를 사용합니다.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-digit-app-password
MAIL_FROM=your-email@gmail.com
FRONTEND_URL=http://localhost:3000

# 색상 분석 보정값(실제 사진 CSV 검증 후 조정)
COLOR_YELLOW_LAB_B_GOOD=132
COLOR_YELLOW_LAB_B_HIGH=175
COLOR_GUM_LAB_A_GOOD=140
COLOR_GUM_LAB_A_HIGH=185
COLOR_GUM_HSV_S_GOOD=70
COLOR_GUM_HSV_S_HIGH=180

# SMTP 값을 비워두면 실제 메일 대신 서버 콘솔에 재설정 링크가 출력됩니다.
